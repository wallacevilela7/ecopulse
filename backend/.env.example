# ==========================================
# Configurações do EcoPulse Backend (.env)
# ==========================================

# Aplicação
APP_ENV=development
API_PORT=8000

# Segurança e Autenticação
API_SECRET_KEY=chave-secreta-estacao-unip-2026

# Arquitetura Dual-Pipeline (Hot Path / Cold Path)
# Janela de consolidação estatística para escrita no banco (padrão WMO: 300s = 5 minutos)
COLD_PATH_WINDOW_SECONDS=300

# Banco de Dados PostgreSQL (Cold Path)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecopulse_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecopulse_db
