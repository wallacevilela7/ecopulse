# ==========================================
# Configurações do EcoPulse Backend (.env)
# ==========================================

# Aplicação
APP_ENV=development
API_PORT=8000
DEBUG=True

# Segurança e Autenticação
API_SECRET_KEY=chave-secreta-estacao-unip-2026

# Banco de Dados PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecopulse_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecopulse_db

# Parâmetros de Estação
DEFAULT_DEVICE_ID=esp32-meteo-01
ALERT_RAIN_THRESHOLD_PCT=15.0
ALERT_HEAT_INDEX_CRITICAL_C=38.0
